# PostgreSQL is the deployment default. Set this explicitly for local SQLite.
# DATABASE_URL=sqlite:///voiceprint.db

# PostgreSQL from docker-compose.yml
# DATABASE_URL=postgresql+psycopg://voiceprint:voiceprint@localhost:5432/voiceprint

# base.en is the fast default; small.en is more accurate and ~3x slower
# WHISPER_MODEL=small.en

# AUDIO_RETENTION_DAYS=30

# Comma-separated browser origins for deployment. Pydantic settings accepts a
# JSON list when supplied as an environment variable, for example:
# CORS_ORIGINS=["https://your-site.netlify.app"]
